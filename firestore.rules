rules_version = '2';

// WATCHTOWER Firestore security rules.
//
// Model (v0.60.0): one owner, identified by the `owner: true` custom claim on
// their Firebase Auth token (granted with `npm run grant-owner` or the "Grant
// owner" GitHub workflow), plus members. Anyone who signs in with Google may
// create their own members/{uid} document with role "pending"; only the owner
// can change a role. Roles: viewer (read everything, own watchlist), editor
// (viewer + incidents + acknowledge/dismiss alerts), blocked. Alert rules and
// people stay owner-only. No UID or email is stored in this file.
//
// The collector writes with the Admin SDK from GitHub Actions, which bypasses
// these rules. The browser therefore gets read-only access to collected data;
// nothing a browser does can create, alter or delete intelligence records.
//
// Tested by rules-tests/firestore.rules.test.ts against the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.get('owner', false) == true;
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }
    function hasRole(roles) {
      return request.auth != null && exists(memberPath()) && get(memberPath()).data.role in roles;
    }
    function canView() { return isOwner() || hasRole(['viewer', 'editor']); }
    function canEdit() { return isOwner() || hasRole(['editor']); }

    // Collector-owned data: owner and members may read; no client may write.
    match /snapshots/{id}       { allow read: if canView(); allow write: if false; }
    match /events/{id}          { allow get, list: if canView(); allow write: if false; }
    match /sourceStatus/{id}    { allow read: if canView(); allow write: if false; }
    match /collectionRuns/{id}  { allow read: if canView(); allow write: if false; }
    match /indicatorHistory/{id} { allow read: if canView(); allow write: if false; }
    match /raiHistory/{id}      { allow read: if canView(); allow write: if false; }

    // Collector-internal state (ETags, advisory baselines): never exposed to clients.
    match /sourceState/{id}     { allow read, write: if false; }

    // Collector-internal bookkeeping (notification cooldowns).
    match /collectorState/{id}  { allow read, write: if false; }

    // Alert rules: owner-managed. Shape is validated here; deep validation of
    // the condition happens in the collector, which skips and reports invalid rules.
    function validRule(d, id) {
      return d.keys().hasOnly(['id', 'name', 'enabled', 'severity', 'trigger', 'notify', 'cooldownMinutes', 'version', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'name', 'enabled', 'severity', 'trigger', 'notify', 'cooldownMinutes', 'version', 'createdAt', 'updatedAt'])
        && d.id == id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.enabled is bool
        && d.severity in ['INFORMATION', 'ADVISORY', 'WARNING', 'CRITICAL']
        && d.trigger is map && d.trigger.kind in ['event', 'indicator', 'rai']
        && d.notify is map && d.notify.keys().hasOnly(['discord']) && d.notify.discord is bool
        && d.cooldownMinutes is int && d.cooldownMinutes >= 0 && d.cooldownMinutes <= 10080
        && d.version is int && d.version >= 1
        && d.createdAt is string && d.updatedAt is string;
    }
    match /alertRules/{id} {
      allow read: if canView();
      allow delete: if isOwner();
      allow create, update: if isOwner() && validRule(request.resource.data, id);
    }

    // Alerts: created only by the collector; the owner and editors may acknowledge / dismiss
    // and, from v0.67.0, give feedback (a verdict and a short note) or clear it.
    function validFeedback(f) {
      return f == null || (f is map
        && f.keys().hasOnly(['verdict', 'note', 'at']) && f.keys().hasAll(['verdict', 'note', 'at'])
        && f.verdict in ['useful', 'irrelevant', 'false-positive', 'miscategorised']
        && f.note is string && f.note.size() <= 500
        && f.at is string && f.at.size() <= 40);
    }
    match /alerts/{id} {
      allow read: if canView();
      allow update: if canEdit()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt', 'dismissed', 'dismissedAt', 'feedback'])
        && request.resource.data.acknowledged is bool
        && request.resource.data.dismissed is bool
        && validFeedback(request.resource.data.get('feedback', null));
      allow create, delete: if false;
    }

    // Missed or late incidents (v0.67.0): logged by the owner and editors for the scorecard.
    function validMissed(d, id) {
      return d.keys().hasOnly(['id', 'title', 'occurredAt', 'kind', 'lateHours', 'regionIds', 'category', 'url', 'note', 'createdAt', 'updatedAt', 'version'])
        && d.keys().hasAll(['id', 'title', 'occurredAt', 'kind', 'lateHours', 'regionIds', 'category', 'url', 'note', 'createdAt', 'updatedAt', 'version'])
        && d.id == id
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.occurredAt is string && d.occurredAt.size() <= 40
        && d.kind in ['missed', 'late']
        && (d.lateHours == null || ((d.lateHours is int || d.lateHours is float) && d.lateHours > 0 && d.lateHours <= 2160))
        && d.regionIds is list && d.regionIds.size() <= 8
        && d.category is string && d.category.size() <= 20
        && d.url is string && d.url.size() <= 500 && (d.url == '' || d.url.matches('https://[^ ]+'))
        && d.note is string && d.note.size() <= 1000
        && d.createdAt is string && d.updatedAt is string
        && d.version is int;
    }
    match /missedIncidents/{id} {
      allow read: if canView();
      allow delete: if canEdit();
      allow create: if canEdit() && validMissed(request.resource.data, id) && request.resource.data.version == 1;
      allow update: if canEdit() && validMissed(request.resource.data, id)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Incident dossiers: owner-curated. Shape and size limits are enforced here;
    // updates must bump `version` by exactly 1 (optimistic concurrency).
    function validIncident(d, id) {
      return d.keys().hasOnly(['id', 'title', 'summary', 'status', 'category', 'regionIds', 'evidence', 'notes', 'linkedIncidentIds', 'indicatorIds', 'createdAt', 'updatedAt', 'version'])
        && d.keys().hasAll(['id', 'title', 'summary', 'status', 'category', 'regionIds', 'evidence', 'notes', 'linkedIncidentIds', 'indicatorIds', 'createdAt', 'updatedAt', 'version'])
        && d.id == id
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.summary is string && d.summary.size() <= 4000
        && d.status in ['developing', 'stable', 'closed']
        && d.category is string && d.category.size() <= 20
        && d.regionIds is list && d.regionIds.size() <= 7
        && d.evidence is list && d.evidence.size() <= 200
        && d.notes is list && d.notes.size() <= 100
        && d.linkedIncidentIds is list && d.linkedIncidentIds.size() <= 20 && !(id in d.linkedIncidentIds)
        && d.indicatorIds is list && d.indicatorIds.size() <= 30
        && d.createdAt is string && d.updatedAt is string
        && d.version is int;
    }
    match /incidents/{id} {
      allow read: if canView();
      allow delete: if canEdit();
      allow create: if canEdit() && validIncident(request.resource.data, id) && request.resource.data.version == 1;
      allow update: if canEdit() && validIncident(request.resource.data, id)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Watchlist: one document per user. Top-level shape and size are enforced here (rules
    // cannot check every list element); the app and the collector validate each item and the
    // collector skips and reports an invalid list. Saves must bump `version` by exactly 1.
    function validWatchlist(d) {
      return d.keys().hasOnly(['items', 'updatedAt', 'version'])
        && d.keys().hasAll(['items', 'updatedAt', 'version'])
        && d.items is list && d.items.size() <= 100
        && d.updatedAt is string && d.updatedAt.size() <= 40
        && d.version is int;
    }
    match /watchlists/{uid} {
      allow read, delete: if canView() && request.auth.uid == uid;
      allow create: if canView() && request.auth.uid == uid && validWatchlist(request.resource.data) && request.resource.data.version == 1;
      allow update: if canView() && request.auth.uid == uid && validWatchlist(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
    }

    match /userSettings/{uid} {
      allow read, write: if canView() && request.auth.uid == uid;
    }

    // People (v0.60.0). Each person writes only their own document, only with role "pending" on
    // creation, and afterwards only their contact fields; `ownerAccount` must match their token.
    // Only the owner reads the list and changes roles.
    function validMember(d, uid) {
      return d.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'ownerAccount', 'createdAt', 'lastSeenAt', 'roleSetAt'])
        && d.keys().hasAll(['uid', 'email', 'displayName', 'role', 'ownerAccount', 'createdAt', 'lastSeenAt'])
        && d.uid == uid
        && (d.email == null || (d.email is string && d.email.size() <= 320))
        && (d.displayName == null || (d.displayName is string && d.displayName.size() <= 200))
        && d.role in ['pending', 'viewer', 'editor', 'blocked']
        && d.ownerAccount is bool
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.lastSeenAt is string && d.lastSeenAt.size() <= 40;
    }
    match /members/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && validMember(request.resource.data, uid)
        && request.resource.data.role == 'pending'
        && !('roleSetAt' in request.resource.data)
        && request.resource.data.ownerAccount == isOwner();
      allow update: if validMember(request.resource.data, uid) && (
        (request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'lastSeenAt', 'ownerAccount'])
          && request.resource.data.ownerAccount == isOwner())
        || (isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleSetAt'])
          && request.resource.data.roleSetAt is string && request.resource.data.roleSetAt.size() <= 40));
      allow delete: if isOwner();
    }

    // Everything else is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
