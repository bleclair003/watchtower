rules_version = '2';

// WATCHTOWER Firestore security rules.
//
// Model: a single authorized owner, identified by the `owner: true` custom
// claim on their Firebase Auth token (granted with `npm run grant-owner` or the
// "Grant owner" GitHub workflow). No UID or email is stored in this file.
//
// The collector writes with the Admin SDK from GitHub Actions, which bypasses
// these rules. The browser therefore gets read-only access to collected data;
// nothing a browser does can create, alter or delete intelligence records.
//
// Tested by rules-tests/firestore.rules.test.ts against the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.owner == true;
    }

    // Collector-owned data: owner may read; no client may write.
    match /snapshots/{id}       { allow read: if isOwner(); allow write: if false; }
    match /events/{id}          { allow get, list: if isOwner(); allow write: if false; }
    match /sourceStatus/{id}    { allow read: if isOwner(); allow write: if false; }
    match /collectionRuns/{id}  { allow read: if isOwner(); allow write: if false; }
    match /indicatorHistory/{id} { allow read: if isOwner(); allow write: if false; }
    match /raiHistory/{id}      { allow read: if isOwner(); allow write: if false; }

    // Collector-internal state (ETags, advisory baselines): never exposed to clients.
    match /sourceState/{id}     { allow read, write: if false; }

    // Collector-internal bookkeeping (notification cooldowns).
    match /collectorState/{id}  { allow read, write: if false; }

    // Alert rules: owner-managed. Shape is validated here; deep validation of
    // the condition happens in the collector, which skips and reports invalid rules.
    function validRule(d, id) {
      return d.keys().hasOnly(['id', 'name', 'enabled', 'severity', 'trigger', 'notify', 'cooldownMinutes', 'version', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'name', 'enabled', 'severity', 'trigger', 'notify', 'cooldownMinutes', 'version', 'createdAt', 'updatedAt'])
        && d.id == id
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.enabled is bool
        && d.severity in ['INFORMATION', 'ADVISORY', 'WARNING', 'CRITICAL']
        && d.trigger is map && d.trigger.kind in ['event', 'indicator', 'rai']
        && d.notify is map && d.notify.keys().hasOnly(['discord']) && d.notify.discord is bool
        && d.cooldownMinutes is int && d.cooldownMinutes >= 0 && d.cooldownMinutes <= 10080
        && d.version is int && d.version >= 1
        && d.createdAt is string && d.updatedAt is string;
    }
    match /alertRules/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validRule(request.resource.data, id);
    }

    // Alerts: created only by the collector; the owner may acknowledge / dismiss.
    match /alerts/{id} {
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt', 'dismissed', 'dismissedAt'])
        && request.resource.data.acknowledged is bool
        && request.resource.data.dismissed is bool;
      allow create, delete: if false;
    }

    // Incident dossiers: owner-curated. Shape and size limits are enforced here;
    // updates must bump `version` by exactly 1 (optimistic concurrency).
    function validIncident(d, id) {
      return d.keys().hasOnly(['id', 'title', 'summary', 'status', 'category', 'regionIds', 'evidence', 'notes', 'linkedIncidentIds', 'indicatorIds', 'createdAt', 'updatedAt', 'version'])
        && d.keys().hasAll(['id', 'title', 'summary', 'status', 'category', 'regionIds', 'evidence', 'notes', 'linkedIncidentIds', 'indicatorIds', 'createdAt', 'updatedAt', 'version'])
        && d.id == id
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.summary is string && d.summary.size() <= 4000
        && d.status in ['developing', 'stable', 'closed']
        && d.category is string && d.category.size() <= 20
        && d.regionIds is list && d.regionIds.size() <= 7
        && d.evidence is list && d.evidence.size() <= 200
        && d.notes is list && d.notes.size() <= 100
        && d.linkedIncidentIds is list && d.linkedIncidentIds.size() <= 20 && !(id in d.linkedIncidentIds)
        && d.indicatorIds is list && d.indicatorIds.size() <= 30
        && d.createdAt is string && d.updatedAt is string
        && d.version is int;
    }
    match /incidents/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validIncident(request.resource.data, id) && request.resource.data.version == 1;
      allow update: if isOwner() && validIncident(request.resource.data, id)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /userSettings/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    // Everything else is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
