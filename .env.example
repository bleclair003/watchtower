# Copy to .env.local (gitignored) and fill in from Firebase console → Project settings → Your apps → Web app.
# These Firebase *web* config values are not secrets; Firestore security rules enforce access.
# NEVER put service-account keys or webhook URLs in this file — those belong in GitHub Actions secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
